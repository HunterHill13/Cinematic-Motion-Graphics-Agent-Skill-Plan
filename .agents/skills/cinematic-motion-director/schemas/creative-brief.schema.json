{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBrief",
  "type": "object",
  "required": [
    "title",
    "objective",
    "audience",
    "duration_seconds",
    "aspect_ratio",
    "fps",
    "language",
    "genre",
    "tone",
    "palette_preset"
  ],
  "properties": {
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "audience": { "type": "string" },
    "duration_seconds": { "type": "number", "minimum": 5, "maximum": 600 },
    "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:5"] },
    "fps": { "type": "integer", "enum": [24, 30, 60] },
    "language": { "type": "string", "enum": ["en", "zh", "fa", "es", "fr", "de"] },
    "genre": {
      "type": "string",
      "enum": ["educational", "scientific_medical", "documentary", "product_launch", "explainer"]
    },
    "tone": { "type": "string" },
    "palette_preset": {
      "type": "string",
      "enum": ["medicalBio", "darkTech", "warmEditorial", "warmPremium"]
    },
    "key_message": { "type": "string" },
    "emotional_arc": { "type": "string" }
  }
}
